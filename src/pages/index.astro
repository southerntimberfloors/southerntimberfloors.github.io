---
// Homepage: follows the flow of the previous site (hero → product carousel → statement →
// "Get inspired" projects → carpet → value props → choosing a floor → enquiry CTA),
// with the same soft fade-ins as you scroll.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { siteImages, projectImages } from '../data/images';
import { business, categories, categoryOrder, choosingCopy, projects, promos } from '../data/site';
import { products } from '../data/products';

// Every floor, grouped by type in menu order (the previous homepage carousel did the same).
const rail = categoryOrder.flatMap((k) => products.filter((p) => p.category === k));
---
<Base
  title="Southern Timber Floors | Mornington & Melbourne Timber Floor Specialists"
  description={business.description}
  overlayHeader
  footerCta={false}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <Photo img={siteImages.hero} alt="" eager sizes="100vw" />
    </div>
    <div class="hero__in">
      <h1 class="hero__h1">
        <span class="line"><span>Discover the Enduring</span></span>
        <span class="line"><span>Beauty of Timber Floors</span></span>
      </h1>
      <a class="arrow-btn hero__btn" href="/timber">
        <span class="arrow-btn__label">Explore Our Range</span>
        <span class="arrow-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span>
      </a>
    </div>
  </section>

  <!-- Products carousel -->
  <section class="block block--edge">
    <div class="edge">
      <span class="eyebrow" data-reveal>Our Products</span>
      <h2 class="block__h" data-reveal>Beautiful flooring solutions<br /> for modern Australian homes</h2>
      <ul class="pills" data-reveal>
        {categoryOrder.map((k) => <li><a class="btn btn--timber btn--sm" href={categories[k].path}>{categories[k].name}</a></li>)}
      </ul>
    </div>
    <div class="rail" data-rail>
      <div class="rail__track" data-rail-track tabindex="0" aria-label="Our flooring range">
        {
          rail.map((p, i) => {
            // Every card shows the board itself; where there's a room photo it fades in on hover (as on the product pages).
            const swatch = p.images[0];
            const room = p.category !== 'carpet' ? p.images[1] : undefined;
            return (
              <a href={`/flooring/${p.slug}`} class="pcard" data-reveal={i < 6 ? '' : undefined}>
                <div class="pcard__media">
                  {swatch && <Photo img={swatch} alt="" sizes="(min-width: 1200px) 30vw, (min-width: 640px) 45vw, 80vw" />}
                  {room && <Photo img={room} alt="" class="pcard__room" sizes="(min-width: 1200px) 30vw, (min-width: 640px) 45vw, 80vw" />}
                </div>
                <span class="pcard__meta">
                  <span class="pcard__name">{p.name}</span>
                  <span class="pcard__cat">{categories[p.category].name}</span>
                </span>
              </a>
            );
          })
        }
      </div>
      <div class="edge rail__ui">
        <div class="rail__bar" aria-hidden="true"><span data-rail-progress></span></div>
        <div class="rail__nav">
          <button type="button" class="rail__btn" data-rail-prev aria-label="Previous floors"><svg viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></button>
          <button type="button" class="rail__btn" data-rail-next aria-label="Next floors"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></button>
        </div>
      </div>
    </div>
  </section>

  <!-- Statement + projects (one soft gradient band, as on the previous site) -->
  <section class="block block--gradient">
    <div class="wrap statement" data-reveal>
      <span class="eyebrow">inspired living</span>
      <h2 class="statement__h">Unlock the possibilities of wood and create extraordinary environments that highlight the natural elegance and warmth of timber floors</h2>
    </div>

    <div class="inspired">
      <div class="edge inspired__head">
        <h2 class="display" data-reveal="down">Get inspired</h2>
        <a class="arrow-btn" href="/projects">
          <span class="arrow-btn__label">View Full Gallery</span>
          <span class="arrow-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span>
        </a>
      </div>
      <div class="rail rail--projects" data-rail>
        <div class="rail__track" data-rail-track tabindex="0" aria-label="Projects">
          {
            projects.map((pr) => {
              const cover = projectImages[pr.slug]?.[0];
              return (
                <a href={`/projects/${pr.slug}`} class="prcard" data-reveal>
                  {cover && <Photo img={cover} alt="" sizes="(min-width: 1200px) 34vw, (min-width: 640px) 50vw, 85vw" />}
                  <span class="prcard__name">{pr.name}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Carpet -->
  <section class="mcol">
    <div class="mcol__media" data-reveal><Photo img={siteImages['carpet-promo']} alt="Crossley Twist carpet in a living room" /></div>
    <div class="mcol__body">
      <h2 class="mcol__h" data-reveal>Carpet solutions <span>now available at Southern Timber Floors</span></h2>
      <p class="mcol__kicker" data-reveal>Multiple colour options available for our Blairgowrie, Crossley Twist, Hemisphere and Windslow carpet ranges</p>
      <div data-reveal>
        <p>Southern timber floors is pleased to offer the best of Australian made Carpets to provide our builders and clients a beautiful selection to bring warmth and softness into the home.</p>
        <p>Our focus has been to find the best quality and durability to offer a selection of on-trend colours and styles.</p>
        <a class="arrow-btn arrow-btn--dark" href="/timber/carpet">
          <span class="arrow-btn__label">View Carpet Products</span>
          <span class="arrow-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section class="block">
    <div class="edge values">
      {promos.map((p, i) => (
        <article class="value" data-reveal>
          <img src={`/images/icons/promo-${i + 1}.svg`} alt="" width="88" height="88" loading="lazy" />
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <a class="link-arrow" href={p.link.href}>{p.link.label} →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Choosing a floor (original copy) -->
  <section class="mcol mcol--reverse">
    <div class="mcol__media" data-reveal><Photo img={siteImages['showroom-frame']} alt="Southern Timber Floors showroom displays" /></div>
    <div class="mcol__body">
      <h2 class="mcol__h mcol__h--plain" data-reveal>{choosingCopy.heading}</h2>
      <p class="mcol__kicker" data-reveal>Solid, Hybrid, Engineered &amp; Parquetry Timber</p>
      <div data-reveal>
        {choosingCopy.body.map((p) => <p>{p}</p>)}
        <a class="arrow-btn arrow-btn--dark" href="/timber">
          <span class="arrow-btn__label">View Our Range</span>
          <span class="arrow-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Enquiry CTA -->
  <section class="cta-green">
    <div class="edge cta-green__in">
      <div class="cta-green__body" data-reveal>
        <p class="cta-green__h">Let us bring your architectural vision to life. <span>Get in touch with our dedicated team to request samples, spec sheets and presentations.</span></p>
        <a class="arrow-btn arrow-btn--dark" href="/about-us/frequently-asked-questions/contact">
          <span class="arrow-btn__label">Enquire now</span>
          <span class="arrow-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Horizontal carousels: arrow buttons, drag-free native scrolling with snap, and a progress bar.
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]')!;
    const bar = rail.querySelector<HTMLElement>('[data-rail-progress]');
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      return card ? (card.offsetWidth + 12) * Math.max(1, Math.floor(track.clientWidth / (card.offsetWidth + 12))) : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = max > 0 ? track.scrollLeft / max : 1;
      if (bar) {
        bar.style.width = `${Math.max(8, (track.clientWidth / track.scrollWidth) * 100)}%`;
        bar.style.transform = `translateX(${ratio * ((100 / parseFloat(bar.style.width)) * 100 - 100)}%)`;
      }
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max - 2;
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  /* ---------- Hero: inset, rounded, full height ---------- */
  .hero {
    position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: end;
    margin: 0 clamp(8px, 1.2vw, 16px); border-radius: 0 0 clamp(14px, 2vw, 30px) clamp(14px, 2vw, 30px);
    min-height: clamp(560px, 100svh, 900px); background: #000; color: #fff;
  }
  /* Phones: leave room for the fixed Call / Samples / Enquire bar. */
  @media (max-width: 899px) { .hero { min-height: max(520px, calc(100svh - 84px)); } }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg :global(img) { opacity: 0.62; animation: hero-img 2.2s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes hero-img { from { opacity: 0; transform: scale(1.08); } }
  .hero__in { width: 100%; padding: calc(var(--header-h) + 40px) clamp(20px, 3vw, 44px) clamp(28px, 4vw, 52px); }
  .hero__h1 { color: #fff; font-size: clamp(2.6rem, 6.4vw, 6rem); line-height: 1; letter-spacing: -0.035em; max-width: none; margin: 0 0 clamp(24px, 3.5vw, 48px); }
  .line { display: block; overflow: clip; padding-bottom: 0.08em; }
  .line > span { display: inline-block; animation: line-up 1s cubic-bezier(.2,.7,.2,1) both; }
  .line:nth-child(1) > span { animation-delay: .55s; }
  .line:nth-child(2) > span { animation-delay: .7s; }
  .hero__btn { animation: fade-up .9s cubic-bezier(.2,.7,.2,1) 1s both; }
  @keyframes line-up { from { opacity: 0; transform: translateY(100%); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(24px); } }
  @media (prefers-reduced-motion: reduce) { .hero__bg :global(img), .line > span, .hero__btn { animation: none; } }

  /* ---------- Pill + round-arrow button (previous site's style) ---------- */
  .arrow-btn { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; --bg: var(--brand); --fg: var(--brand-ink); }
  .arrow-btn--dark { --bg: var(--ink); --fg: var(--brand); }
  .arrow-btn__label { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--bg); color: var(--fg); font: 600 0.82rem/1 var(--sans); letter-spacing: 0.06em; text-transform: uppercase; transition: background .25s, color .25s; }
  .arrow-btn__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--bg); color: var(--fg); overflow: hidden; transition: background .25s, color .25s; }
  .arrow-btn__icon svg { width: 20px; height: 20px; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .arrow-btn:hover .arrow-btn__icon svg { transform: translateX(4px); }
  .arrow-btn:hover .arrow-btn__label, .arrow-btn:hover .arrow-btn__icon { background: var(--fg); color: var(--bg); }
  .arrow-btn--dark:hover .arrow-btn__label, .arrow-btn--dark:hover .arrow-btn__icon { background: var(--ink-2); color: var(--brand); }

  /* ---------- Blocks ---------- */
  .block { padding: clamp(72px, 10vw, 140px) 0; }
  /* Homepage sections line up with the hero text on the left and use the full width of the screen. */
  .block, .cta-green { --edge: calc(clamp(8px, 1.2vw, 16px) + clamp(20px, 3vw, 44px)); }
  .edge { padding-inline: var(--edge); }
  .block .rail__track { padding-inline: var(--edge); scroll-padding-inline: var(--edge); }
  .block__h { font-size: clamp(2rem, 3.6vw, 3.2rem); max-width: 20ch; }
  .pills { list-style: none; padding: 0; margin: clamp(24px, 3vw, 40px) 0 clamp(32px, 4vw, 48px); display: flex; flex-wrap: wrap; gap: 10px; }
  .pills .btn { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.78rem; }

  /* ---------- Carousels ---------- */
  .rail__track {
    display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain;
    padding: 0 max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))); scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    scrollbar-width: none;
  }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__track:focus-visible { outline-offset: -2px; }
  .rail__ui { display: flex; align-items: center; gap: 24px; margin-top: 28px; }
  .rail__bar { flex: 1; height: 2px; background: var(--line); overflow: hidden; }
  .rail__bar span { display: block; height: 100%; background: var(--ink); transition: transform .15s linear; }
  .rail__nav { display: flex; gap: 8px; }
  .rail__btn { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; transition: background .2s, color .2s, opacity .2s; }
  .rail__btn svg { width: 20px; height: 20px; }
  .rail__btn:hover:not(:disabled) { background: var(--ink); color: var(--brand); }
  .rail__btn:disabled { opacity: 0.3; cursor: default; }

  /* Product card: swatch floating over a room photo, the room is revealed on hover */
  .pcard { flex: 0 0 min(78vw, 340px); scroll-snap-align: start; text-decoration: none; color: inherit; }
  @media (min-width: 900px) { .pcard { flex-basis: clamp(280px, calc((100vw - 2 * var(--edge) - 36px) / 4), 420px); } }
  .pcard__media { position: relative; aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: var(--sand); }
  .pcard__media :global(img) { transition: transform 1.2s cubic-bezier(.2,.7,.2,1), opacity .5s ease; }
  .pcard__media :global(.pcard__room) { position: absolute; inset: 0; opacity: 0; }
  .pcard:hover .pcard__media :global(img) { transform: scale(1.05); }
  .pcard:hover .pcard__media :global(.pcard__room) { opacity: 1; }
  .pcard__meta { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding-top: 14px; }
  .pcard__name { font: 400 1.15rem/1.2 var(--serif); letter-spacing: -0.01em; }
  .pcard__cat { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }

  /* ---------- Statement + Get inspired ---------- */
  .block--gradient { background: linear-gradient(180deg, var(--cream) 0%, var(--paper) 45%, var(--cream) 100%); }
  .statement { text-align: center; padding-bottom: clamp(72px, 10vw, 140px); }
  .statement__h { font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.2; max-width: 34ch; margin: 0 auto; }
  .inspired__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; flex-wrap: wrap; position: relative; z-index: 2; margin-bottom: calc(clamp(3.6rem, 13vw, 12rem) * -0.32); }
  .display { font-size: clamp(3.6rem, 13vw, 12rem); line-height: 0.9; letter-spacing: -0.05em; margin: 0; color: var(--ink); }
  .inspired__head .arrow-btn { margin-bottom: calc(clamp(3.6rem, 13vw, 12rem) * 0.42); }
  @media (max-width: 899px) { .inspired__head .arrow-btn { display: none; } }
  .prcard { position: relative; flex: 0 0 min(85vw, 520px); aspect-ratio: 5 / 4; scroll-snap-align: start; border-radius: var(--radius-sm); overflow: hidden; color: #fff; text-decoration: none; isolation: isolate; }
  .prcard :global(img) { position: absolute; inset: 0; z-index: -1; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .prcard::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.55)); }
  .prcard:hover :global(img) { transform: scale(1.05); }
  .prcard__name { position: absolute; left: 0; right: 0; bottom: 22px; text-align: center; font: 500 1.05rem var(--sans); }
  .rail--projects .rail__track { padding-bottom: 4px; }

  /* ---------- Media columns (edge-to-edge photo + text panel) ---------- */
  .mcol { display: grid; grid-template-columns: 1fr; background: var(--sand); }
  @media (min-width: 900px) { .mcol { grid-template-columns: 1fr 1fr; } .mcol--reverse .mcol__media { order: 2; } }
  .mcol__media { min-height: 360px; position: relative; }
  .mcol__media :global(img) { position: absolute; inset: 0; }
  .mcol__body { padding: clamp(48px, 7vw, 120px) clamp(20px, 5vw, 96px); align-self: center; max-width: 720px; }
  .mcol__h { font-size: clamp(2rem, 3.4vw, 3rem); margin-bottom: 0.6em; }
  .mcol__h span { display: block; color: var(--muted); }
  .mcol__kicker { font: 400 1.15rem/1.45 var(--serif); color: var(--ink); max-width: 40ch; }
  .mcol__body p:not(.mcol__kicker) { color: var(--ink-2); max-width: 56ch; }
  .mcol__body .arrow-btn { margin-top: 12px; }

  /* ---------- Value props ---------- */
  .values { display: grid; gap: clamp(48px, 5vw, 32px); grid-template-columns: 1fr; text-align: center; }
  @media (min-width: 700px) { .values { grid-template-columns: 1fr 1fr; text-align: left; } }
  @media (min-width: 1100px) { .values { grid-template-columns: repeat(4, 1fr); } }
  .value img { width: 88px; height: 88px; margin-bottom: 20px; }
  .value h3 { font-size: 1.35rem; max-width: 16ch; }
  @media (max-width: 699px) { .value h3 { margin-inline: auto; } }
  .value p { color: var(--ink-2); font-size: 0.95rem; }

  /* ---------- Green enquiry CTA ---------- */
  .cta-green { background: var(--brand); color: var(--brand-ink); padding: clamp(96px, 11vw, 150px) 0; }
  .cta-green__in { display: flex; justify-content: flex-end; }
  .cta-green__body { width: 100%; max-width: 620px; }
  .cta-green__h { font: 400 clamp(1.5rem, 2.6vw, 2.2rem)/1.2 var(--serif); letter-spacing: -0.02em; margin-bottom: 32px; }
  .cta-green__h span { color: #5e6150; }
</style>
