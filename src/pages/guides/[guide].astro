---
// Online versions of the downloadable guides. The wording comes straight from the Word documents in
// public/downloads (via scripts/guides-from-docx.py → src/data/guides.json), so the two always match.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import guides from '../../data/guides.json';
import { business, paths } from '../../data/site';

type Block =
  | { type: 'h'; text: string }
  | { type: 'p'; html: string }
  | { type: 'note'; html: string; label?: string }
  | { type: 'ul'; items: string[] }
  | { type: 'sign'; fields: string[] };
type Guide = { eyebrow: string; title: string; subtitle?: string; statement?: string[]; blocks: Block[]; download: string };

export function getStaticPaths() {
  return Object.keys(guides).map((guide) => ({ params: { guide } }));
}
const g = (guides as Record<string, Guide>)[Astro.params.guide!];
const pageTitle = g.subtitle ? `${g.title}: ${g.subtitle}` : g.title.startsWith('Engineered') ? `Engineered Flooring Maintenance & Care` : g.title;
const strip = (h: string) => h.replace(/<[^>]+>/g, '');
const firstText = g.statement?.join(' ') ?? strip((g.blocks.find((b) => b.type === 'p') as { html: string } | undefined)?.html ?? '');
---
<Base title={pageTitle} description={firstText.slice(0, 155)} crumbs={[{ label: 'Maintenance & Information Guides', href: paths.catalogues }, { label: pageTitle }]}>
  <div class="wrap guide-wrap">
    <div class="guide-tools no-print">
      <a class="btn btn--sm" href={g.download} download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" /></svg>
        Download (.docx)
      </a>
      <button type="button" class="btn btn--ghost btn--sm" onclick="window.print()">Print or save as PDF</button>
    </div>

    <article class="doc">
      <header class="doc__head">
        <div class="doc__letterhead">
          <span class="doc__logo"><Logo /></span>
          <p>{business.address.street} {business.address.suburb} {business.address.postcode}<br />{business.phone.replace('(03) ', '')}<br />www.southerntimberfloors.com</p>
        </div>
        <img class="doc__banner" src="/images/guides/banner.webp" alt="" width="898" height="332" />
        <span class="doc__eyebrow">{g.eyebrow}</span>
        <h1>{g.title}</h1>
        {g.subtitle && <p class="doc__subtitle">{g.subtitle}</p>}
        {g.statement && <div class="doc__statement">{g.statement.map((l) => <p>{l}</p>)}</div>}
      </header>

      {g.blocks.map((b) => {
        if (b.type === 'h') return <h2>{b.text}</h2>;
        if (b.type === 'p') return <p set:html={b.html} />;
        if (b.type === 'ul') return <ul>{b.items.map((i) => <li set:html={i} />)}</ul>;
        if (b.type === 'note') return (
          <div class="doc__note">
            {b.label && <span class="doc__note-label">{b.label}</span>}
            <p set:html={b.html} />
          </div>
        );
        return (
          <div class="doc__sign">
            {b.fields.map((f) => <div><span>{f}:</span></div>)}
          </div>
        );
      })}
    </article>
  </div>
</Base>
<style>
  .guide-wrap { max-width: 900px; padding-bottom: 80px; }
  .guide-tools { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; margin: 8px 0 16px; }
  .guide-tools svg { width: 16px; height: 16px; }

  /* Laid out like the printed document: a white page with the letterhead and banner photo. */
  .doc { background: #fff; color: #222; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(24px, 6vw, 64px); box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.25); font-size: 0.98rem; line-height: 1.6; }
  .doc__letterhead { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid #e4e1db; }
  .doc__logo { display: block; }
  .doc__logo :global(.logo) { color: #111; }
  .doc__letterhead p { margin: 0; text-align: right; font-size: 0.8rem; line-height: 1.5; color: #555; }
  .doc__banner { display: block; width: 100%; height: auto; border-radius: 4px; margin-bottom: 28px; }
  .doc__eyebrow { display: block; font: 600 0.78rem var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--timber); margin-bottom: 6px; }
  .doc h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0 0 6px; color: #111; }
  .doc__subtitle { font: 500 1.15rem/1.3 var(--sans); color: #333; margin: 0 0 8px; }
  .doc__statement { margin: 22px 0 6px; padding: 18px 22px; background: #f6f4f0; border-radius: 6px; }
  .doc__statement p { margin: 0; font-weight: 600; color: #222; }
  .doc h2 { font-size: 1.3rem; margin: 34px 0 10px; color: #111; }
  .doc p { margin: 0 0 12px; }
  .doc ul { margin: 0 0 14px; padding-left: 1.25em; }
  .doc li { margin: 0 0 8px; padding-left: 4px; }
  .doc li::marker { color: var(--timber); }
  .doc :global(strong) { font-weight: 600; color: #111; }
  .doc__note { margin: 22px 0; padding: 16px 20px; border-left: 3px solid var(--timber); background: #f6f4f0; border-radius: 0 6px 6px 0; }
  .doc__note p { margin: 0; }
  .doc__note-label { display: block; font: 700 0.8rem var(--sans); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }
  .doc__sign { display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 24px; margin-top: 36px; }
  .doc__sign div { border-bottom: 1px solid #999; padding-bottom: 28px; font-weight: 600; font-size: 0.9rem; }

  @media (max-width: 600px) {
    .doc__letterhead { flex-direction: column; align-items: flex-start; }
    .doc__letterhead p { text-align: left; }
    .doc__sign { grid-template-columns: 1fr; }
  }
  @media print {
    :global(.topbar), :global(.header), :global(.footer), :global(.mobile-bar), :global(.crumbs), .no-print { display: none !important; }
    :global(body) { background: #fff; padding: 0; }
    .guide-wrap { max-width: none; padding: 0; }
    .doc { border: 0; box-shadow: none; padding: 0; }
  }
</style>
