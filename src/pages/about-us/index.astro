---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { siteImages } from '../../data/images';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, projects } from '../../data/site';
---
<Base title="About us" description={business.description} crumbs={[{ label: 'About Us' }]}>
  <section class="page-hero">
    <div class="wrap split">
      <div>
        <span class="eyebrow">inspired living</span>
        <h1>About Southern Timber Floors</h1>
        <p class="lead">Based on the Mornington Peninsula, Southern Timber Floors specialises in the supply, installation and finishing of solid and engineered timber flooring.</p>
        <p>Established in 2005, we bring together extensive industry experience, quality craftsmanship and a genuine commitment to personal service. Over the years, we've built a reputation for delivering considered flooring solutions, with a focus on quality products, attention to detail and getting the right result for every project.</p>
      </div>
      <div class="media" style="aspect-ratio:5/4"><Photo img={siteImages['about-1']} alt="Red Hill engineered timber floor in a living room" eager /></div>
    </div>
  </section>
  <section class="section section--paper">
    <div class="wrap split" style="align-items:start">
      <div>
        <span class="eyebrow">our industry experience</span>
        <h2>Industry experience, knowledge and genuine service</h2>
        <div class="media about-pic"><Photo img={siteImages['about-3']} alt="Timber staircase and floor" sizes="(min-width: 900px) 40vw, 100vw" /></div>
      </div>
      <div>
        <p class="lead">Our team brings together extensive industry experience and practical knowledge across all aspects of timber flooring. We take pride in providing knowledgeable advice and personalised service, helping our clients navigate the many choices available in flooring, colours, finishes and installation methods.</p>
        <p>With so many options to consider, we believe it's important to understand how different flooring products perform and how they suit individual environments. We take the time to guide our clients through the selection process, helping them make informed decisions that balance design preferences, practical considerations and lifestyle needs.</p>
      </div>
    </div>
  </section>
  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">Our work</span><h2>See how our flooring solutions have transformed homes</h2></div><a class="link-arrow" href="/projects">All projects →</a></div>
      <div class="grid grid-3">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .h3 { font-size: 1.45rem; }
  .about-pic { margin-top: 32px; aspect-ratio: 4 / 5; max-width: 420px; }
</style>
