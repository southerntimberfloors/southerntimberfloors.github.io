---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { catalogues } from '../../data/site';
import { siteImages } from '../../data/images';
---
<Base title="Catalogues & Guides" description="Free care, maintenance and installation guides for engineered, hybrid and timber flooring. Read online or download." crumbs={[{ label: 'About', href: '/about-us' }, { label: 'Catalogues & Guides' }]}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Support &amp; resources</span>
      <h1>Catalogues &amp; Guides</h1>
      <p class="lead">Practical guides for looking after your floor. Read them online (they work well on a phone and print neatly), or download the original documents. Trade spec sheets and catalogues are available on request.</p>
    </div>
  </section>
  <section class="section--tight" style="padding-top:0">
    <div class="wrap grid grid-3">
      {catalogues.map((c) => (
        <article class="doc card">
          <a href={c.href} class="doc__cover" tabindex="-1" aria-hidden="true"><Photo img={siteImages[c.cover]} alt="" sizes="(min-width: 1000px) 33vw, 100vw" /></a>
          <div class="card--pad">
            <h2 class="h3"><a href={c.href}>{c.title}</a></h2>
            <div class="doc__actions">
              <a class="btn btn--sm" href={c.href}>Read online</a>
              <a class="btn btn--ghost btn--sm" href={c.download} download>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" /></svg>
                Download (.docx)
              </a>
            </div>
          </div>
        </article>
      ))}
      <article class="doc card doc--trade">
        <div class="card--pad">
          <span class="eyebrow">For trade</span>
          <h2 class="h3">Spec sheets &amp; product catalogues</h2>
          <p class="muted">Technical data, acoustic ratings and presentation material for builders, architects and designers.</p>
          <a class="btn btn--timber btn--sm" href="/about-us/frequently-asked-questions/contact?request=specs">Request by email</a>
        </div>
      </article>
    </div>
  </section>
</Base>
<style>
  .doc { display: flex; flex-direction: column; }
  .doc__cover { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand); }
  .doc__cover :global(img) { object-fit: cover; transition: transform .6s ease; }
  .doc:hover .doc__cover :global(img) { transform: scale(1.03); }
  .doc h2 a { text-decoration: none; }
  .doc__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .doc--trade { background: var(--sand); justify-content: center; }
  .h3 { font-size: 1.3rem; }
</style>
