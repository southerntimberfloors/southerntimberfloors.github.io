---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { siteImages } from '../../data/images';
import { business } from '../../data/site';
---
<Base title="Mornington Showroom" description={`Visit our timber flooring showroom at ${business.address.street}, ${business.address.suburb}. Solid, engineered, hybrid and carpet on display. Open Mon–Fri, Saturday by appointment.`} crumbs={[{ label: 'About', href: '/about-us' }, { label: 'Showroom' }]}>
  <section class="page-hero">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{business.address.street}, {business.address.suburb} {business.address.state} {business.address.postcode}</span>
        <h1>Our Showroom</h1>
        <h2 class="h3">Discover Timber Flooring at Our Mornington Showroom</h2>
        <p class="lead">Explore one of the largest showroom displays of solid timber, engineered timber and hybrid flooring, alongside our carefully selected carpet range. With a wide variety of styles, colours and finishes to view, you can compare options and get a real feel for how they work within your space.</p>
        <p>Bring along your plans, samples and other interior finishes and make use of our spacious design bench. Our team can help you explore different combinations, discuss colour and technical considerations, and find the right flooring to complement your home, lifestyle and overall design.</p>
        <div class="row">
          <a class="btn btn--timber" href="/about-us/frequently-asked-questions/contact?request=consultation">Book a free 1-hr consultation</a>
          <a class="btn btn--ghost" href={business.mapsUrl} target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
      <div class="media" style="aspect-ratio:4/5"><Photo img={siteImages['showroom-1']} alt="Inside the Southern Timber Floors showroom in Mornington" eager /></div>
    </div>
  </section>
  <section class="section--tight" style="padding-top:0">
    <div class="wrap show-pics">
      <div class="media"><Photo img={siteImages['showroom-2']} alt="Flooring displays in the showroom" /></div>
      <div class="media"><Photo img={siteImages['showroom-hires']} alt="Showroom design bench and samples" /></div>
      <div class="media"><Photo img={siteImages['showroom-exterior']} alt={`Showroom exterior at ${business.address.street}, ${business.address.suburb}`} /></div>
    </div>
  </section>
  <section class="section section--paper">
    <div class="wrap visit">
      <div class="visit__info">
        <h2>Plan your visit</h2>
        <h3 class="lbl">Opening hours</h3>
        <dl class="hours">{business.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.note ?? `${h.open} – ${h.close}`}</dd></>))}</dl>
        <p class="status"><span class="dot" data-open-dot></span><span data-open-text></span></p>
        <h3 class="lbl">Address</h3>
        <p>{business.address.street}<br />{business.address.suburb} {business.address.state} {business.address.postcode}</p>
        <h3 class="lbl">Contact</h3>
        <p><a href={business.phoneHref}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <h3 class="lbl">Tips for your visit</h3>
        <ul class="checklist">
          <li>Bring photos or plans of the rooms you are flooring</li>
          <li>Bring samples of benchtops, tiles, paint and fabrics</li>
          <li>Book ahead for Saturdays or for a dedicated consultant</li>
        </ul>
      </div>
      <div class="visit__map">
        <iframe title={`Map showing ${business.name}, ${business.address.street} ${business.address.suburb}`} src={business.mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
<style>
  .show-pics { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .show-pics .media { aspect-ratio: 4 / 3; }
  .h3 { font-size: clamp(1.3rem, 2vw, 1.6rem); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .visit { display: grid; gap: 32px; }
  @media (min-width: 900px) { .visit { grid-template-columns: 1fr 1.3fr; } }
  .visit__map { min-height: 420px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--sand); }
  .visit__map iframe { width: 100%; height: 100%; min-height: 420px; border: 0; display: block; }
  .lbl { font: 600 0.75rem var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--timber); margin: 24px 0 8px; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; margin: 0; }
  .hours dd { margin: 0; font-weight: 600; }
  .status { display: flex; gap: 8px; align-items: center; font-size: 0.9rem; margin-top: 12px; color: var(--ink-2); }
  .status .dot { background: #b5ab9e; }
  .status :global(.dot.is-open) { background: var(--ok); }
</style>
