---
// Short alias. GitHub Pages can't do server 301s, so this forwards instantly and is excluded from search.
// (On Cloudflare Pages / Netlify, public/_redirects issues a real 301 instead.)
import { paths } from '../data/site';
const target = paths.contact;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <title>Contact Us | Southern Timber Floors</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://www.southerntimberfloors.com${target}`} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search);</script>
  </head>
  <body><p><a href={target}>Continue to Contact Us</a></p></body>
</html>
