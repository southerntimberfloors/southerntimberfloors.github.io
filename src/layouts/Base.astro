---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SampleDrawer from '../components/SampleDrawer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { business } from '../data/site';
import legacySeo from '../data/legacy-seo.json';

interface Props {
  title: string;
  description: string;
  crumbs?: { label: string; href?: string }[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  /** Homepage: header floats transparently over the hero photo. */
  overlayHeader?: boolean;
  /** Hide the footer's own call-to-action (when the page already ends with one). */
  footerCta?: boolean;
}
const { title, description, crumbs, schema, ogImage = '/og.png', overlayHeader = false, footerCta = true } = Astro.props;
const site = Astro.site ?? new URL('https://www.southerntimberfloors.com');
// Canonical URLs match the previous site exactly: no trailing slash, no .html.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(path, site).href;
// For every URL that existed on the previous site, reuse its exact <title> (and description where it had one).
const legacy = (legacySeo as Record<string, { title: string | null; description: string | null }>)[path];
const fullTitle = legacy?.title ?? (title.includes(business.name) ? title : `${title} | ${business.name}`);
const metaDescription = legacy?.description ?? description;
const { gtm, ga4 } = business.tracking;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  description: business.description,
  foundingDate: String(business.founded),
  '@id': `${site.origin}/#business`,
  name: business.name,
  url: site.origin,
  telephone: '+61359736936',
  email: business.email,
  image: new URL('/og.png', site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.suburb,
    addressRegion: business.address.state,
    postalCode: business.address.postcode,
    addressCountry: business.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:30', closes: '16:00' },
  ],
  areaServed: ['Mornington Peninsula', 'Melbourne', 'Gippsland', 'Victoria'],
  sameAs: [business.social.instagram.url, business.social.facebook.url],
};
const crumbSchema = crumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: new URL(c.href, site).href } : {}),
      })),
    }
  : null;
const schemas = [localBusiness, crumbSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])].filter(Boolean);
---
<!doctype html>
<html lang="en-AU" class="no-js">
  <head>
    <meta charset="utf-8" />
    {/* Google Tag Manager + GA4: same containers as the previous site */}
    <script is:inline define:vars={{ gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);</script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
    <script is:inline define:vars={{ ga4 }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',ga4);</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="all" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#191919" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      {
        crumbs && (
          <nav class="crumbs wrap" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c, i) => (
                <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <Footer cta={footerCta} />
    <SampleDrawer />
    <SiteSearch />

    <nav class="mobile-bar" aria-label="Quick actions">
      <a href={business.phoneHref} class="mobile-bar__btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2" /></svg>
        Call
      </a>
      <button type="button" class="mobile-bar__btn" data-open-samples>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a4 4 0 018 0v2" /></svg>
        Samples <span class="count-badge" data-sample-count hidden>0</span>
      </button>
      <a href="/about-us/frequently-asked-questions/contact" class="mobile-bar__btn mobile-bar__btn--primary">Enquire</a>
    </nav>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgb(250 250 250 / 0.96);
    backdrop-filter: blur(10px); border-top: 1px solid var(--line);
  }
  .mobile-bar__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 46px; border-radius: 999px;
    border: 1px solid var(--line); background: #fff; color: var(--ink); font: 600 0.9rem var(--sans); text-decoration: none; cursor: pointer;
  }
  .mobile-bar__btn svg { width: 18px; height: 18px; }
  .mobile-bar__btn--primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  :global(body) { padding-bottom: 76px; }
  @media (min-width: 900px) { .mobile-bar { display: none; } :global(body) { padding-bottom: 0; } }
</style>
