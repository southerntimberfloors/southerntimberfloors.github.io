---
import type { Img } from '../data/images';
interface Props {
  img: Img;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Use only the small file (e.g. tiny thumbnails). */
  small?: boolean;
}
const { img, alt, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, class: cls = '', small = false } = Astro.props;
---
<img
  class={`photo ${cls}`}
  src={small ? img.thumb : img.src}
  srcset={small ? undefined : `${img.thumb} 440w, ${img.src} 1366w`}
  sizes={small ? undefined : sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
/>
<style>
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; background: var(--sand); }
</style>
