---
import { business, categories, categoryOrder, services } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__cta">
      <div>
        <span class="eyebrow">Start your project</span>
        <h2>Samples, spec sheets, a site visit, or just a chat.</h2>
      </div>
      <div class="footer__cta-actions">
        <a class="btn btn--timber" href="/about-us/frequently-asked-questions/contact">Enquire now</a>
        <a class="btn btn--ghost-light" href={business.phoneHref}>{business.phone}</a>
      </div>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <Logo light />
        <p>Locally owned and operated timber flooring specialists, specialising in the supply, installation and finishing of timber flooring across the Mornington Peninsula, Melbourne and beyond since {business.founded}.</p>
        <div class="footer__social">
          <a href={business.social.instagram.url} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
          </a>
          <a href={business.social.facebook.url} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3a4 4 0 00-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z" /></svg>
          </a>
        </div>
      </div>
      <div>
        <h3>Products</h3>
        <ul>
          {categoryOrder.map((k) => <li><a href={categories[k].path}>{categories[k].name}</a></li>)}
          <li><a href="/timber">Browse all flooring</a></li>
        </ul>
      </div>
      <div>
        <h3>Services</h3>
        <ul>{services.map((s) => <li><a href={`/our-services/${s.slug}`}>{s.name}</a></li>)}</ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/about-us">About us</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/about-us/catalogues-guides">Catalogues &amp; guides</a></li>
          <li><a href="/about-us/sustainability">Sustainability</a></li>
          <li><a href="/about-us/frequently-asked-questions">FAQ</a></li>
          <li><a href="/about-us/frequently-asked-questions/contact">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <h3>Showroom</h3>
        <address>
          <a href={business.mapsUrl} target="_blank" rel="noopener">{business.address.street}<br />{business.address.suburb} {business.address.state} {business.address.postcode}</a>
        </address>
        <p><a href={business.phoneHref}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <dl class="footer__hours">
          {business.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.note ?? `${h.open} – ${h.close}`}</dd></>))}
        </dl>
      </div>
    </div>
    <div class="footer__base">
      <span>© {year} {business.name}. All rights reserved.</span>
      <span>Proudly 100% Melbourne owned &amp; operated</span>
    </div>
  </div>
</footer>
<style>
  .footer { background: var(--ink); color: #c9c7c3; padding: clamp(48px, 7vw, 88px) 0 32px; }
  .footer a { text-decoration: none; }
  .footer a:hover { color: #fff; }
  .footer h2 { color: var(--cream); max-width: 22ch; margin: 0; }
  .footer h3 { font: 600 0.75rem var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand); margin-bottom: 16px; }
  .footer .eyebrow { color: var(--brand); }
  .footer__cta { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: end; padding-bottom: clamp(36px, 5vw, 56px); border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .footer__cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .footer__grid { display: grid; gap: 36px; padding: clamp(36px, 5vw, 56px) 0; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .footer__brand { grid-column: 1 / -1; max-width: 360px; }
  @media (min-width: 1000px) { .footer__grid { grid-template-columns: 1.6fr 1fr 1.2fr 1fr 1.3fr; } .footer__brand { grid-column: auto; } }
  .footer__brand p { margin: 18px 0; font-size: 0.92rem; }
  .footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; font-size: 0.92rem; }
  .footer address { font-style: normal; margin-bottom: 12px; font-size: 0.92rem; }
  .footer p { font-size: 0.92rem; }
  .footer__hours { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 0.82rem; margin: 0; }
  .footer__hours dd { margin: 0; color: #fff; }
  .footer__social { display: flex; gap: 10px; }
  .footer__social a { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.2); display: grid; place-items: center; }
  .footer__social svg { width: 18px; height: 18px; }
  .footer__base { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; padding-top: 24px; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 0.8rem; color: #8f8d89; }
</style>
