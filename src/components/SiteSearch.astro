---
// Site-wide search, opened from the magnifying glass in the header (or "/" on a keyboard).
// Searches products, ranges, services, projects, guides, pages and FAQs from /search-index.json.
---
<dialog class="ss" data-search aria-label="Search the site">
  <div class="ss__panel">
    <div class="ss__bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
      <input type="search" placeholder="Search floors, services, projects, guides…" aria-label="Search" autocomplete="off" data-search-q />
      <button type="button" class="ss__close" data-search-close aria-label="Close search">Esc</button>
    </div>
    <div class="ss__results" data-search-results aria-live="polite">
      <p class="ss__hint">Try “Spotted Gum”, “herringbone”, “installation” or “cleaning”.</p>
    </div>
  </div>
</dialog>

<style>
  .ss { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; }
  .ss::backdrop { background: rgb(20 18 15 / 0.45); backdrop-filter: blur(3px); }
  .ss__panel { width: min(760px, calc(100% - 24px)); margin: clamp(12px, 8vh, 90px) auto 0; background: var(--paper); border-radius: var(--radius); box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.5); overflow: hidden; display: flex; flex-direction: column; max-height: calc(100% - clamp(24px, 16vh, 180px)); }
  .ss__bar { display: flex; align-items: center; gap: 12px; padding: 0 16px; border-bottom: 1px solid var(--line); }
  .ss__bar svg { width: 20px; height: 20px; color: var(--muted); flex: none; }
  .ss__bar input { flex: 1; min-width: 0; height: 64px; border: 0; background: none; font: 400 1.15rem var(--sans); color: var(--ink); outline: none; }
  .ss__close { border: 1px solid var(--line); background: #fff; border-radius: 6px; padding: 4px 8px; font: 600 0.72rem var(--sans); color: var(--muted); cursor: pointer; }
  .ss__results { overflow-y: auto; padding: 8px; }
  .ss__hint, .ss__empty { padding: 18px 12px; margin: 0; color: var(--muted); font-size: 0.92rem; }
  .ss__results :global(.ss__group) { padding: 10px 12px 4px; font: 600 0.7rem var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--timber); }
  .ss__results :global(a) { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: var(--radius-sm); text-decoration: none; color: var(--ink); }
  .ss__results :global(a:hover), .ss__results :global(a[aria-selected='true']) { background: var(--sand); }
  .ss__results :global(img), .ss__results :global(.ss__ico) { width: 44px; height: 44px; border-radius: 6px; object-fit: cover; flex: none; background: var(--sand); }
  .ss__results :global(.ss__ico) { display: grid; place-items: center; font: 600 0.65rem var(--sans); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .ss__results :global(.ss__t) { display: block; font-weight: 500; }
  .ss__results :global(.ss__s) { display: block; font-size: 0.82rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ss__results :global(a > span:last-child) { min-width: 0; }
</style>

<script>
  type Entry = { t: string; s: string; u: string; k: string; i?: string; x?: string };
  const dlg = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const q = dlg.querySelector<HTMLInputElement>('[data-search-q]')!;
  const box = dlg.querySelector<HTMLElement>('[data-search-results]')!;
  const hint = box.innerHTML;
  const order = ['Product', 'Range', 'Service', 'Project', 'Guide', 'Page', 'FAQ'];
  const groupName: Record<string, string> = { Product: 'Products', Range: 'Ranges', Service: 'Services', Project: 'Projects', Guide: 'Guides', Page: 'Pages', FAQ: 'FAQs' };
  let index: Entry[] | null = null;
  let active = -1;

  const load = async () => {
    if (index) return index;
    const res = await fetch('/search-index.json');
    index = (await res.json()) as Entry[];
    return index;
  };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function score(e: Entry, terms: string[]) {
    const t = norm(e.t), all = norm(`${e.t} ${e.s} ${e.x ?? ''}`);
    if (!terms.every((w) => all.includes(w))) return 0;
    let n = 1;
    for (const w of terms) {
      if (t.startsWith(w)) n += 6;
      else if (new RegExp(`\\b${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(t)) n += 4;
      else if (t.includes(w)) n += 2;
      else if (norm(e.s).includes(w)) n += 1;
    }
    return n;
  }

  async function run() {
    const terms = norm(q.value).split(/\s+/).filter(Boolean);
    active = -1;
    if (!terms.length) { box.innerHTML = hint; return; }
    const hits = (await load())
      .map((e) => ({ e, n: score(e, terms) }))
      .filter((h) => h.n > 0)
      .sort((a, b) => b.n - a.n);
    if (!hits.length) {
      box.innerHTML = `<p class="ss__empty">Nothing found for “${esc(q.value.trim())}”. We have many more options in our showroom, so <a href="/about-us/frequently-asked-questions/contact" style="display:inline;padding:0;text-decoration:underline">ask us</a>.</p>`;
      return;
    }
    const groups = order
      .map((k) => ({ k, items: hits.filter((h) => h.e.k === k).slice(0, k === 'Product' ? 8 : 4) }))
      .filter((g) => g.items.length);
    box.innerHTML = groups
      .map((g) => `<div class="ss__group">${groupName[g.k]}</div>` + g.items.map(({ e }) =>
        `<a href="${esc(e.u)}">${e.i ? `<img src="${esc(e.i)}" alt="" loading="lazy" />` : `<span class="ss__ico">${esc(e.k)}</span>`}<span><span class="ss__t">${esc(e.t)}</span>${e.s ? `<span class="ss__s">${esc(e.s)}</span>` : ''}</span></a>`,
      ).join(''))
      .join('');
  }

  function open() {
    if (dlg.open) return;
    dlg.showModal();
    q.select();
    load();
  }
  document.querySelectorAll<HTMLElement>('[data-open-search]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); open(); }));
  dlg.querySelector('[data-search-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  let t: number | undefined;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(run, 80); });
  q.addEventListener('keydown', (e) => {
    const links = [...box.querySelectorAll<HTMLAnchorElement>('a[href]')];
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = Math.max(0, Math.min(links.length - 1, active + (e.key === 'ArrowDown' ? 1 : -1)));
      links.forEach((l, i) => l.setAttribute('aria-selected', String(i === active)));
      links[active]?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter' && links.length) {
      e.preventDefault();
      location.href = (links[active] ?? links[0]).href;
    }
  });
  document.addEventListener('keydown', (e) => {
    const el = document.activeElement as HTMLElement | null;
    const typing = el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
    if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) { e.preventDefault(); open(); }
  });
</script>
