---
import ProductCard from './ProductCard.astro';
import { categories, categoryOrder, tones, type CategoryKey } from '../data/site';
import { products } from '../data/products';
interface Props { initial?: CategoryKey }
const { initial } = Astro.props;
const list = initial ? products.filter((p) => p.category === initial) : products;
---
<div class="cat-ui" data-catalogue data-initial={initial ?? ''}>
  <div class="cat-ui__bar">
    {
      !initial && (
        <div class="cat-ui__group" role="group" aria-label="Flooring type">
          <button type="button" class="pill" data-cat="" aria-pressed="true">All</button>
          {categoryOrder.map((k) => (
            <button type="button" class="pill" data-cat={k} aria-pressed="false">{categories[k].name}</button>
          ))}
        </div>
      )
    }
  </div>
  <div class="cat-ui__bar cat-ui__bar--secondary">
    {initial !== 'carpet' && (
    <div class="cat-ui__group" role="group" aria-label="Colour tone" data-tone-group>
      <span class="cat-ui__label">Tone</span>
      {
        (Object.keys(tones) as (keyof typeof tones)[]).map((t) => (
          <button type="button" class="pill pill--tone" data-tone={t} aria-pressed="false">
            <span class="dot" style={`background:${tones[t].swatch}`}></span>{tones[t].label}
          </button>
        ))
      }
    </div>
    )}
    {
      initial !== 'carpet' && initial !== 'hybrid' && (
        <label class="cat-ui__toggle">
          <input type="checkbox" data-herringbone /> Available in herringbone
        </label>
      )
    }
    <span class="sr-only" aria-live="polite"><span data-count>{list.length}</span> results</span>
  </div>

  <div class="grid grid-4" data-grid>
    {list.map((p) => <ProductCard product={p} showCategory={!initial} />)}
  </div>
  <div class="cat-ui__empty" data-empty hidden>
    <h3>No floors match those filters</h3>
    <p class="muted">Try removing a filter, or ask us. We can often source species and colours not listed here.</p>
    <button type="button" class="btn btn--ghost" data-reset>Clear filters</button>
  </div>
</div>

<style>
  .cat-ui__bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 12px; }
  .cat-ui__bar--secondary { margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .cat-ui__group { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .cat-ui__label { font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-right: 4px; }
  .pill { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); font: 500 0.86rem var(--sans); color: var(--ink); cursor: pointer; transition: .15s; }
  .pill:hover { border-color: var(--ink-2); }
  .pill[aria-pressed='true'] { background: var(--ink); color: var(--brand); border-color: var(--ink); }
  .cat-ui__toggle { display: inline-flex; gap: 8px; align-items: center; font-size: 0.88rem; cursor: pointer; }
  .cat-ui__toggle input { width: 18px; height: 18px; accent-color: var(--timber); }
  .cat-ui__group[hidden] { display: none; }
  .cat-ui__empty { text-align: center; padding: 60px 0; }
</style>

<script>
  // Filters only (searching is done from the header). Each visit starts unfiltered, including when
  // coming back from a product page, so a filter is never left stuck on.
  document.querySelectorAll<HTMLElement>('[data-catalogue]').forEach((root) => {
    const catBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const toneBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tone]')];
    const herr = root.querySelector<HTMLInputElement>('[data-herringbone]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-product]')];
    const count = root.querySelector('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const toneGroup = root.querySelector<HTMLElement>('[data-tone-group]');

    const state = { cat: '', tones: new Set<string>(), herr: false };
    const reset = () => { state.cat = ''; state.tones.clear(); state.herr = false; };

    function apply() {
      let n = 0;
      for (const c of cards) {
        const show =
          (!state.cat || c.dataset.category === state.cat) &&
          (!state.tones.size || (c.dataset.category !== 'carpet' && state.tones.has(c.dataset.tone!))) &&
          (!state.herr || c.dataset.herringbone === '1');
        c.hidden = !show;
        if (show) n++;
      }
      // Colour tones describe timber; they don't apply to carpet ranges.
      if (toneGroup) toneGroup.hidden = state.cat === 'carpet';
      count.textContent = String(n);
      empty.hidden = n > 0;
      catBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === state.cat)));
      toneBtns.forEach((b) => b.setAttribute('aria-pressed', String(state.tones.has(b.dataset.tone!))));
      if (herr) herr.checked = state.herr;
    }

    catBtns.forEach((b) => b.addEventListener('click', () => { state.cat = b.dataset.cat!; apply(); }));
    toneBtns.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.tone!;
      state.tones.has(v) ? state.tones.delete(v) : state.tones.add(v);
      apply();
    }));
    herr?.addEventListener('change', () => { state.herr = herr.checked; apply(); });
    root.querySelector('[data-reset]')?.addEventListener('click', () => { reset(); apply(); });
    // Pressing Back restores the page from the browser's cache; clear any filter left on.
    window.addEventListener('pageshow', (e) => { if (e.persisted) { reset(); apply(); } });
    // Drop old filter links (?type=…) from the address bar.
    if (location.search) history.replaceState(null, '', location.pathname + location.hash);
    apply();
  });
</script>
